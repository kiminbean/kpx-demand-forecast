# J-REF Environment Variables
# Copy this file to .env and fill in your values

# ========================
# 기상청 API (필수)
# ========================
# 공공데이터포털(data.go.kr)에서 발급받은 API 키
# 서비스: 기상청_지상(종관, ASOS) 시간자료 조회서비스
KMA_API_KEY=your_kma_api_key_here

# ========================
# KPX API (선택)
# ========================
# 전력거래소 API 키 (있는 경우)
KPX_API_KEY=

# ========================
# Database (선택)
# ========================
# 데이터베이스 연결 문자열 (향후 확장용)
DATABASE_URL=

# ========================
# Model Serving (선택)
# ========================
# 모델 서빙 설정
MODEL_PATH=./models
API_HOST=0.0.0.0
API_PORT=8000

# ========================
# Logging
# ========================
LOG_LEVEL=INFO
